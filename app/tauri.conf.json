{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stashden",
  "version": "0.33.1",
  "identifier": "com.ferrlabs.roxycloud",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @stashden/web dev",
    "beforeBuildCommand": "pnpm --filter @stashden/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Stashden",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; frame-src 'self' blob:; object-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FerrLabs/Stashden/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERTRERThDMTJFQUMxMDgKUldRSXdlb1NqTjdrSFFCWmJJOUg2c3lBVEtpSGFKWk5UdFNlcWxtNzhiMU1GK1BiOTJVazJkOVkK"
    }
  }
}
