{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoxyCloud",
  "version": "0.15.0",
  "identifier": "com.ferrlabs.roxycloud",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @roxycloud/web dev",
    "beforeBuildCommand": "pnpm --filter @roxycloud/web build"
  },
  "app": {
    "windows": [
      {
        "title": "RoxyCloud",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
